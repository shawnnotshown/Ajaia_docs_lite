rules_version = '2';

// Demo application with mocked authentication.
// Access control is enforced in the frontend.
// For production, replace with Firebase Auth + owner/share checks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }

    match /documents/{documentId} {
      allow read, write: if true;
    }

    match /document_shares/{shareId} {
      allow read, write: if true;
    }

    match /document_presence/{presenceId} {
      allow read, write: if true;
    }

    match /document_comments/{commentId} {
      allow read, write: if true;
    }

    match /document_versions/{versionId} {
      allow read, write: if true;
    }
  }
}
